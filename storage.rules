rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // O sistema usa login anónimo no Firebase para permitir upload/download
    // dos documentos dos clientes sem expor o bucket inteiro.
    match /documentos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
